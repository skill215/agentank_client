{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp2-rule-probe-plan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "operation", "endpoint", "probes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "const": "imp2-official-rule-probes-v1" },
    "operation": { "const": "OFFICIAL_SIMULATE_RULE_PROBE" },
    "endpoint": { "const": "/api/agent/tank/simulate" },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probeId", "ruleOrVariantId", "reachability", "tankProfileIds", "mapId", "objective"],
        "properties": {
          "probeId": { "type": "string", "pattern": "^P2-[A-Z0-9-]+$" },
          "ruleOrVariantId": { "type": "string", "minLength": 1 },
          "reachability": { "enum": ["REACHABLE", "CONDITIONALLY_REACHABLE"] },
          "tankProfileIds": { "type": "array", "minItems": 1, "items": { "enum": ["v1", "v2"] } },
          "mapId": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
