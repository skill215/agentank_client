{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp5-policy-manifest-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestSchemaVersion", "profileId", "sourceKind", "policyAbiRevision", "limits", "integerScales", "strategy", "opponent", "notes"],
  "properties": {
    "manifestSchemaVersion": { "const": 2 },
    "profileId": { "const": "STRAT3_PORTFOLIO_POLICY_V3" },
    "sourceKind": { "enum": ["BUILD_CONFIGURED", "BENCHMARK_SELECTED"] },
    "policyAbiRevision": { "const": 3 },
    "limits": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 },
      "required": ["maxFeatures", "featureCount", "inputCount", "profileCount", "actionFamilyCount", "strategyCount", "opponentEventCount", "opponentContextCount", "riskDimensionCount", "maxPlanSketches", "maxPersistentPlans", "maxPlanEntities", "maxHiddenCells"]
    },
    "integerScales": {
      "type": "object", "additionalProperties": false,
      "required": ["probability", "rawFeature", "weight", "risk"],
      "properties": {
        "probability": { "const": 10000 }, "rawFeature": { "const": 10000 },
        "weight": { "const": 100 }, "risk": { "const": 100 }
      }
    },
    "strategy": {
      "type": "object", "additionalProperties": false,
      "required": ["switchMargin", "minimumDwellRoots", "defaultStrategy",
        "canonicalEvalProfile", "defaultBaseRisk", "allowedStrategicRobustLoss",
        "strategyDescriptorFingerprint"],
      "properties": { "switchMargin": { "type": "integer", "minimum": 0 },
        "minimumDwellRoots": { "type": "integer", "minimum": 1 },
        "defaultStrategy": { "const": "KILL_PRESSURE" },
        "canonicalEvalProfile": { "const": "BASELINE_OUTCOME" },
        "defaultBaseRisk": { "type": "integer", "minimum": 0, "maximum": 100 },
        "allowedStrategicRobustLoss": { "const": 0 },
        "strategyDescriptorFingerprint": {
          "type": "string", "pattern": "^[a-f0-9]{64}$"
        } }
    },
    "opponent": {
      "type": "object", "additionalProperties": false,
      "required": ["fastAlpha", "slowAlpha", "prior"],
      "properties": { "fastAlpha": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "slowAlpha": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "prior": { "type": "integer", "minimum": 0, "maximum": 10000 } }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
