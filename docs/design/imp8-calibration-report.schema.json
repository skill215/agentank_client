{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schemas/imp8-calibration-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportKind", "suiteId", "status", "calibrationStatus",
    "lane", "targetTankProfileId", "branch", "inputFingerprints", "baseline",
    "candidateMatrix", "productionCacheAudit", "invariants", "selection", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportKind": { "const": "IMP8_LOCAL_CALIBRATION_EVIDENCE" },
    "suiteId": { "const": "IMP8_LOCAL_CALIBRATION_SUITE_V1" },
    "status": { "enum": ["PASS", "FAIL"] },
    "calibrationStatus": { "const": "MEASURED_NOT_SELECTED" },
    "lane": { "const": "CALIBRATION" },
    "targetTankProfileId": { "const": "v2" },
    "branch": { "const": "main" },
    "inputFingerprints": { "type": "object", "minProperties": 5,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "baseline": { "type": "object", "required": ["status", "reportFingerprint",
      "localLayerStatuses", "platformStatus", "sourceSha256", "minifiedSha256",
      "sourceMinifiedMismatches", "productionRootBytes"], "additionalProperties": false,
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "reportFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "localLayerStatuses": { "type": "array", "minItems": 5, "maxItems": 5,
          "items": { "enum": ["PASS", "FAIL", "BLOCKED"] } },
        "platformStatus": { "enum": ["BLOCKED", "PASS", "FAIL"] },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "minifiedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceMinifiedMismatches": { "type": "integer", "minimum": 0 },
        "productionRootBytes": { "type": "integer", "minimum": 1 }
      } },
    "candidateMatrix": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["candidateId", "depth", "nodeBudget", "cacheMode",
        "scenarioCount", "sampleCount", "p50Micros", "p95Micros", "maxMicros", "totalNodes",
        "completedDepthMin", "completedDepthMax", "cacheProbes", "cacheHits", "cacheWrites",
        "rootRestoreFailures", "hotAllocations", "strictFingerprint", "semanticFingerprint"],
      "additionalProperties": false,
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 1, "maximum": 6 },
        "nodeBudget": { "type": "integer", "minimum": 1, "maximum": 512 },
        "cacheMode": { "enum": ["OFF", "ON"] },
        "scenarioCount": { "type": "integer", "minimum": 1 },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "p50Micros": { "type": "integer", "minimum": 0 },
        "p95Micros": { "type": "integer", "minimum": 0 },
        "maxMicros": { "type": "integer", "minimum": 0 },
        "totalNodes": { "type": "integer", "minimum": 0 },
        "completedDepthMin": { "type": "integer", "minimum": 0, "maximum": 6 },
        "completedDepthMax": { "type": "integer", "minimum": 0, "maximum": 6 },
        "cacheProbes": { "type": "integer", "minimum": 0 },
        "cacheHits": { "type": "integer", "minimum": 0 },
        "cacheWrites": { "type": "integer", "minimum": 0 },
        "rootRestoreFailures": { "type": "integer", "minimum": 0 },
        "hotAllocations": { "type": "integer", "minimum": 0 },
        "strictFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "semanticFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      } } },
    "productionCacheAudit": { "type": "array", "minItems": 4, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarioId", "offAction", "onAction", "offCacheHits", "onCacheHits",
        "actionMismatch", "hardMismatch", "proofMismatch", "rootRestoreFailures"],
      "properties": {
        "scenarioId": { "type": "string" }, "offAction": { "type": "integer" },
        "onAction": { "type": "integer" }, "offCacheHits": { "type": "integer", "minimum": 0 },
        "onCacheHits": { "type": "integer", "minimum": 0 },
        "actionMismatch": { "type": "integer", "minimum": 0, "maximum": 1 },
        "hardMismatch": { "type": "integer", "minimum": 0, "maximum": 1 },
        "proofMismatch": { "type": "integer", "minimum": 0, "maximum": 1 },
        "rootRestoreFailures": { "type": "integer", "minimum": 0 }
      } } },
    "invariants": { "type": "object", "additionalProperties": false,
      "required": ["rootRestoreFailures", "hotAllocations", "cacheActionMismatches",
        "cacheHardMismatches", "cacheProofMismatches", "sourceMinifiedMismatches",
        "frozenInputCount", "configMutationCount", "allZeroTolerancePass"],
      "properties": {
        "rootRestoreFailures": { "type": "integer", "minimum": 0 },
        "hotAllocations": { "type": "integer", "minimum": 0 },
        "cacheActionMismatches": { "type": "integer", "minimum": 0 },
        "cacheHardMismatches": { "type": "integer", "minimum": 0 },
        "cacheProofMismatches": { "type": "integer", "minimum": 0 },
        "sourceMinifiedMismatches": { "type": "integer", "minimum": 0 },
        "frozenInputCount": { "const": 0 }, "configMutationCount": { "const": 0 },
        "allZeroTolerancePass": { "type": "boolean" }
      } },
    "selection": { "type": "object", "additionalProperties": false,
      "required": ["status", "recommendedCandidateId", "applied", "measuredDimensions",
        "deferredDimensions", "reason"],
      "properties": {
        "status": { "const": "PENDING_QUALITY_ORACLE" },
        "recommendedCandidateId": { "type": "null" }, "applied": { "const": false },
        "measuredDimensions": { "const": ["depth", "cache"] },
        "deferredDimensions": { "const": ["risk", "weights", "arena"] },
        "reason": { "type": "string", "minLength": 1 }
      } },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
