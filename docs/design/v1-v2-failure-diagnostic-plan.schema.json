{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schemas/v1-v2-failure-diagnostic-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "evidenceLane", "candidateManifest", "roles", "repetitions", "timeoutMs", "maxFrames", "maxTraceCases", "traceWindowFrames", "variants", "exactExecution", "traceExecution", "futureCandidatePolicy", "allowProductionMutation", "officialRuleTruth"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "evidenceLane": { "const": "DISCOVERY" },
    "candidateManifest": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["DISCOVERY", "CALIBRATION", "FROZEN_REGRESSION"] }
    },
    "repetitions": { "type": "integer", "minimum": 2, "maximum": 16 },
    "timeoutMs": { "type": "integer", "minimum": 20, "maximum": 1000 },
    "maxFrames": { "const": 128 },
    "maxTraceCases": { "type": "integer", "minimum": 1, "maximum": 128 },
    "traceWindowFrames": { "type": "integer", "minimum": 4, "maximum": 32 },
    "variants": { "const": "NATIVE_AND_SKILL_CROSS_FOUR_CELL" },
    "exactExecution": { "const": "BOTH_IMPLEMENTATIONS_LOADED_FROM_FROZEN_SCRIPT_BYTES" },
    "traceExecution": { "const": "V1_FROZEN_SCRIPT_AND_V2_SAME_PARAMETER_INSTRUMENTED_MIRROR" },
    "futureCandidatePolicy": { "const": "ALL_OBSERVED_RESULTS_BECOME_DISCOVERY_AND_REQUIRE_A_NEW_HOLDOUT_SPLIT" },
    "allowProductionMutation": { "const": false },
    "officialRuleTruth": { "const": false }
  }
}
