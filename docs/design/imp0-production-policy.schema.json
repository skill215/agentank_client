{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp0-production-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "allowedRoots", "deniedRoots", "forbiddenPatterns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "allowedRoots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deniedRoots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbiddenPatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["patternId", "source"],
        "properties": {
          "patternId": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
