{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp6-benchmark-report-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "status", "platformBlocked", "layers", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 }, "reportId": { "const": "imp6-six-layer-benchmark-v1" },
    "status": { "enum": ["PASS", "FAIL"] }, "platformBlocked": { "type": "boolean" },
    "layers": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layerId", "status", "reason", "caseCount", "sampleCount", "metrics", "semanticFingerprint", "bytes"],
        "properties": {
          "layerId": { "enum": ["function", "composite", "pipeline", "terminal", "full-game", "platform"] },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "reason": { "type": ["string", "null"] }, "caseCount": { "type": "integer", "minimum": 0 },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "metrics": {
            "type": ["object", "null"],
            "properties": {
              "p50Micros": { "type": "integer", "minimum": 0 }, "p95Micros": { "type": "integer", "minimum": 0 },
              "p99Micros": { "type": "integer", "minimum": 0 }, "maxMicros": { "type": "integer", "minimum": 0 },
              "operations": { "type": "integer", "minimum": 0 }, "instrumentedAllocations": { "type": "integer", "minimum": 0 },
              "highWater": { "type": "integer", "minimum": 0 }
            },
            "required": ["p50Micros", "p95Micros", "p99Micros", "maxMicros", "operations", "instrumentedAllocations", "highWater"],
            "additionalProperties": false
          },
          "semanticFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
