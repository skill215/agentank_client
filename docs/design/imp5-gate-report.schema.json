{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp5-gate-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "status", "checks", "artifacts", "blockers", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "const": "imp5-integer-policy-gate-v1" },
    "status": { "enum": ["PASS", "FAIL"] },
    "checks": {
      "type": "array", "minItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["checkId", "status", "evidence"],
        "properties": {
          "checkId": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "evidence": { "type": "object" }
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifactId", "relativePath", "sha256"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "relativePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
