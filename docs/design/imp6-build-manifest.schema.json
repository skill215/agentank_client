{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp6-build-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildId", "status", "profileId", "ownSkillId", "evaluatorMode", "sourceHash", "minifiedHash", "sourceBytes", "minifiedBytes", "moduleCount", "moduleFingerprints", "inputFingerprints", "terser", "cache", "memory", "strip", "differential", "sandbox", "artifactFiles", "platformCode", "platformStatus", "releaseEligibility", "blockers", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 }, "buildId": { "const": "imp6-poison-generated-v1" },
    "status": { "enum": ["PASS", "FAIL"] }, "profileId": { "const": "IMP6_LOCAL_RUNTIME_BUILD_V1" },
    "ownSkillId": { "const": 6 }, "evaluatorMode": { "const": "GENERATED" },
    "sourceHash": { "$ref": "#/$defs/hash" }, "minifiedHash": { "$ref": "#/$defs/hash" },
    "sourceBytes": { "type": "integer", "minimum": 1 }, "minifiedBytes": { "type": "integer", "minimum": 1 },
    "moduleCount": { "type": "integer", "minimum": 1 },
    "moduleFingerprints": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
    "inputFingerprints": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
    "terser": { "type": "object", "additionalProperties": false, "required": ["version", "optionsFingerprint"],
      "properties": { "version": { "const": "5.43.1" }, "optionsFingerprint": { "$ref": "#/$defs/hash" } } },
    "cache": { "type": "object", "additionalProperties": false, "required": ["canonicalCount", "enableMask", "optionalDefaultOff"],
      "properties": { "canonicalCount": { "const": 11 }, "enableMask": { "type": "integer", "minimum": 0 },
        "optionalDefaultOff": { "type": "integer", "minimum": 0 } } },
    "memory": { "type": "object", "additionalProperties": false, "required": ["cacheBytes", "emergencyBytes", "productionRootBytes", "totalTypedArrayBytes", "measuredMapCells", "independentEmergency"],
      "properties": { "cacheBytes": { "type": "integer", "minimum": 1 }, "emergencyBytes": { "type": "integer", "minimum": 1 },
        "productionRootBytes": { "type": "integer", "minimum": 1 }, "totalTypedArrayBytes": { "type": "integer", "minimum": 1 },
        "measuredMapCells": { "const": 1024 },
        "independentEmergency": { "const": true } } },
    "strip": { "type": "object", "additionalProperties": false, "required": ["status", "findingCount"],
      "properties": { "status": { "enum": ["PASS", "FAIL"] }, "findingCount": { "type": "integer", "minimum": 0 } } },
    "differential": { "type": "object", "additionalProperties": false, "required": ["status", "mismatchCount", "sourceFingerprint", "minifiedFingerprint"],
      "properties": { "status": { "enum": ["PASS", "FAIL"] }, "mismatchCount": { "type": "integer", "minimum": 0 },
        "sourceFingerprint": { "$ref": "#/$defs/hash" }, "minifiedFingerprint": { "$ref": "#/$defs/hash" } } },
    "sandbox": { "type": "object", "additionalProperties": false, "required": ["status", "mathImulAvailable", "parseInitFixturePassed"],
      "properties": { "status": { "enum": ["PASS", "FAIL"] }, "mathImulAvailable": { "const": false },
        "parseInitFixturePassed": { "type": "boolean" } } },
    "artifactFiles": { "type": "object", "additionalProperties": false, "required": ["source", "minified"],
      "properties": { "source": { "const": "production-source.js" }, "minified": { "const": "production-minified.js" } } },
    "platformCode": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement", "artifactKind", "bytes", "maximumBytes", "warningBytes", "headroomBytes", "withinLimit", "warning"],
      "properties": {
        "measurement": { "const": "UTF8_BYTES" },
        "artifactKind": { "const": "PRODUCTION_MINIFIED" },
        "bytes": { "type": "integer", "minimum": 1 },
        "maximumBytes": { "const": 204800 },
        "warningBytes": { "const": 190000 },
        "headroomBytes": { "type": "integer" },
        "withinLimit": { "type": "boolean" },
        "warning": { "type": "boolean" }
      }
    },
    "platformStatus": { "enum": ["PLATFORM_LIMIT_SATISFIED", "PLATFORM_LIMIT_EXCEEDED"] },
    "releaseEligibility": { "const": false },
    "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "fingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
