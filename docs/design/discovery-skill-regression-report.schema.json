{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schemas/discovery-skill-regression-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportKind", "suiteId", "status", "lane", "role", "laneIsolation", "coverage", "runs", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportKind": { "const": "DISCOVERY_SKILL_REGRESSION" },
    "suiteId": { "type": "string" },
    "status": { "enum": ["PASS", "FAIL"] },
    "lane": { "const": "DISCOVERY" },
    "role": { "const": "REGRESSION_ONLY" },
    "laneIsolation": {
      "type": "object",
      "required": ["tuningAllowed", "calibrationMembership", "frozenMembership"],
      "properties": {
        "tuningAllowed": { "const": false },
        "calibrationMembership": { "const": 0 },
        "frozenMembership": { "const": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["runCount", "matchMemberships", "uniqueMatches", "verifiedArtifacts", "requiredClaims"],
      "properties": {
        "runCount": { "type": "integer", "minimum": 1 },
        "matchMemberships": { "type": "integer", "minimum": 1 },
        "uniqueMatches": { "type": "integer", "minimum": 1 },
        "verifiedArtifacts": { "type": "integer", "minimum": 3 },
        "requiredClaims": { "type": "integer", "minimum": 1 }
      }
    },
    "runs": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
