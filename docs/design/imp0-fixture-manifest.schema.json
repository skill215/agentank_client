{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp0-fixture-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureSetId", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureSetId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixtureId", "relativePath"],
        "properties": {
          "fixtureId": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
          "relativePath": { "type": "string", "pattern": "^engine-v2/test/fixture/.+\\.json$" }
        }
      }
    }
  }
}
