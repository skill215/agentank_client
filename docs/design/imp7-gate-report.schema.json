{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schemas/imp7-gate-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "status", "checks", "artifacts", "blockers", "releaseBlockers", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "const": "imp7-dynamic-corpus-counterfactual-gate-v1" },
    "status": { "enum": ["PASS", "FAIL"] },
    "checks": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "evidence"],
        "properties": {
          "checkId": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "evidence": { "type": "object" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "relativePath", "sha256"],
        "properties": {
          "artifactId": { "type": "string" },
          "relativePath": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "releaseBlockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
