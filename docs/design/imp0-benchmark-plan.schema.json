{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp0-benchmark-plan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkPlanId", "seed", "warmupIterations", "sampleIterations", "layers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "benchmarkPlanId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "seed": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "warmupIterations": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "sampleIterations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "layers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layerId", "directory"],
        "properties": {
          "layerId": { "enum": ["function", "composite", "pipeline", "terminal", "full-game", "platform"] },
          "directory": { "type": "string", "pattern": "^engine-v2/bench/" }
        }
      }
    }
  }
}
