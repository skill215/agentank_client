{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentank.local/schema/imp0-benchmark-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "benchmarkPlanId", "planFingerprint", "status", "runtime", "layers", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "minLength": 1 },
    "benchmarkPlanId": { "type": "string", "minLength": 1 },
    "planFingerprint": { "$ref": "#/$defs/hash" },
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "platform", "arch"],
      "properties": {
        "node": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layerId", "status", "reason", "caseCount", "sampleCount", "metrics", "semanticFingerprint"],
        "properties": {
          "layerId": { "enum": ["function", "composite", "pipeline", "terminal", "full-game", "platform"] },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "reason": { "type": ["string", "null"] },
          "caseCount": { "type": "integer", "minimum": 0 },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "metrics": { "type": ["object", "null"] },
          "semanticFingerprint": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
        }
      }
    },
    "fingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
